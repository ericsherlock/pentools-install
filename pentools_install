#!/usr/bin/env bash
#
# pentools_install — multi-OS penetration-testing toolkit installer.
#
# Phase 1 (this revision): platform auto-detection, a unified manifest
# resolver, and a --dry-run planner. Native package managers supported:
# apt, dnf, pacman, and Homebrew. Python tools install via pipx (PEP 668
# safe); Ruby/Go/git tools via their own handlers.
#
# Category selection, interactive menus, and the full flag set land in a
# later phase; this revision installs (or plans) the whole manifest.

set -euo pipefail

# --- Locate ourselves and load libraries ------------------------------------
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
MANIFEST="${PT_MANIFEST:-$SCRIPT_DIR/tools.manifest}"
LOGFILE="${PT_LOGFILE:-$SCRIPT_DIR/install_log}"

# --- Runtime state (defaults; overridden by flags) --------------------------
PT_DRY_RUN=0
PT_ASSUME_YES=0
PT_ALL=0
PT_ONLY=""          # comma-separated category allowlist (from --only)
PT_SKIP=""          # comma-separated tool-name denylist (from --skip)
PT_SELECTED=""      # resolved comma-separated category selection
PT_SAMPLE=0         # install only first N tools per category (0 = all)
PT_SAMPLE_TOOLS=""  # resolved space-separated sampled tool names
PT_GIT_DIR="$SCRIPT_DIR/pentesting-tools"

# Detection globals (populated by detect_platform)
PT_OS="" PT_DISTRO="" PT_PKG_MGR="" PT_PKG_COL="" PT_ARCH="" PT_NEEDS_ROOT=1

# Run counters
COUNT_PLANNED=0 COUNT_OK=0 COUNT_SKIP=0 COUNT_FAIL=0 COUNT_DESELECTED=0
FAILED_TOOLS="" SKIPPED_TOOLS=""

# --- Logging ----------------------------------------------------------------
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOGFILE"
}

die() {
    log "ERROR: $*"
    exit 1
}

# --- Load libs --------------------------------------------------------------
# shellcheck source=lib/detect.sh
. "$SCRIPT_DIR/lib/detect.sh"
# shellcheck source=lib/installers.sh
. "$SCRIPT_DIR/lib/installers.sh"
# shellcheck source=lib/ui.sh
. "$SCRIPT_DIR/lib/ui.sh"

usage() {
    cat <<EOF
Usage: $0 [options]

Options:
  --all             Install every category (no interactive menu).
  --only <cats>     Install only these categories (comma separated).
  --skip <tools>    Skip these tools by name (comma separated).
  --sample <N>      Install only the first N tools per selected category
                    (0 = all). Used by the CI smoke tier.
  --dry-run         Show what would be installed without changing anything.
  --yes, -y         Assume "yes" to prompts; install all if no --only given.
  --list            List all tools in the manifest and exit.
  --categories      List available categories with tool counts and exit.
  --help, -h        Show this help and exit.

The package manager is auto-detected (apt / dnf / pacman / brew).
With no selection flags, an interactive category menu is shown.
Manifest: $MANIFEST
EOF
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --all)        PT_ALL=1 ;;
            --only)       shift; [ "$#" -gt 0 ] || die "--only needs an argument"; PT_ONLY="$1" ;;
            --only=*)     PT_ONLY="${1#*=}" ;;
            --skip)       shift; [ "$#" -gt 0 ] || die "--skip needs an argument"; PT_SKIP="$1" ;;
            --skip=*)     PT_SKIP="${1#*=}" ;;
            --sample)     shift; [ "$#" -gt 0 ] || die "--sample needs a number"; PT_SAMPLE="$1" ;;
            --sample=*)   PT_SAMPLE="${1#*=}" ;;
            --dry-run)    PT_DRY_RUN=1 ;;
            --yes|-y)     PT_ASSUME_YES=1 ;;
            --list)       DO_LIST=1 ;;
            --categories) DO_CATEGORIES=1 ;;
            --help|-h)    usage; exit 0 ;;
            *)            usage; die "Unknown argument: $1" ;;
        esac
        shift
    done
}

# --- Manifest parsing -------------------------------------------------------
# Manifest columns (pipe-delimited, whitespace trimmed):
#   name | category | method | apt | dnf | pacman | brew | fallback
# A "-" (or empty) column means "not available via that path".

# trim <string> : strip leading/trailing whitespace.
trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# manifest_column <name> : return the 0-based index for a pkg-manager column.
manifest_column() {
    case "$1" in
        apt) echo 3 ;; dnf) echo 4 ;; pacman) echo 5 ;; brew) echo 6 ;;
        *) echo -1 ;;
    esac
}

# resolve_tool <fields...> : decide how to install the current tool for the
# detected platform. Sets R_NAME, R_CAT, R_ACTION (native|fallback|skip),
# R_ARG, R_WHY, R_CHECK. Native package wins when available; else fallback.
# The optional 9th field is an explicit "already installed?" probe command;
# it defaults to the tool name when omitted.
resolve_tool() {
    local name="$1" cat="$2" apt="$4" dnf="$5" pac="$6" brew="$7" fb="$8" check="${9:-}"
    R_NAME="$name" R_CAT="$cat" R_ACTION="skip" R_ARG="" R_WHY=""
    R_CHECK="$check"
    [ -z "$R_CHECK" ] || [ "$R_CHECK" = "-" ] && R_CHECK="$name"

    local col
    case "$PT_PKG_COL" in
        apt)    col="$apt" ;;
        dnf)    col="$dnf" ;;
        pacman) col="$pac" ;;
        brew)   col="$brew" ;;
        *)      col="-" ;;
    esac

    if [ -n "$col" ] && [ "$col" != "-" ]; then
        R_ACTION="native"; R_ARG="$col"; R_WHY="$PT_PKG_MGR pkg"
    elif [ -n "$fb" ] && [ "$fb" != "-" ]; then
        R_ACTION="fallback"; R_ARG="$fb"; R_WHY="${fb%%:*}"
    else
        R_ACTION="skip"; R_WHY="not available on $PT_PKG_MGR"
    fi
}

# for_each_tool <callback> : parse the manifest and invoke <callback> with the
# trimmed fields for every non-comment, non-blank line. The 9th field (an
# optional idempotency-check command) is passed when present.
for_each_tool() {
    local cb="$1" line f1 f2 f3 f4 f5 f6 f7 f8 f9
    while IFS= read -r line || [ -n "$line" ]; do
        line="$(trim "$line")"
        [ -z "$line" ] && continue
        case "$line" in \#*) continue ;; esac
        IFS='|' read -r f1 f2 f3 f4 f5 f6 f7 f8 f9 <<EOF
$line
EOF
        "$cb" "$(trim "$f1")" "$(trim "$f2")" "$(trim "$f3")" \
              "$(trim "$f4")" "$(trim "$f5")" "$(trim "$f6")" \
              "$(trim "$f7")" "$(trim "$f8")" "$(trim "$f9")"
    done < "$MANIFEST"
}

# --- Callbacks --------------------------------------------------------------
list_cb() {
    printf '  %-18s %-14s %s\n' "$1" "$2" "$3"
}

install_cb() {
    resolve_tool "$@"

    # Category selection: "base" is always installed; other categories must be
    # in the resolved selection. Deselected tools are silently counted.
    if [ "$R_CAT" != "base" ] && ! csv_contains "$PT_SELECTED" "$R_CAT"; then
        COUNT_DESELECTED=$((COUNT_DESELECTED + 1))
        return 0
    fi

    # Sample mode (--sample N): keep only the first N tools per category.
    # "base" always installs (fallbacks depend on it).
    if [ "${PT_SAMPLE:-0}" -gt 0 ] && [ "$R_CAT" != "base" ]; then
        case " $PT_SAMPLE_TOOLS " in
            *" $R_NAME "*) : ;;
            *) COUNT_DESELECTED=$((COUNT_DESELECTED + 1)); return 0 ;;
        esac
    fi

    # Explicit per-tool skip list (--skip).
    if [ -n "$PT_SKIP" ] && csv_contains "$PT_SKIP" "$R_NAME"; then
        log "SKIP  $R_NAME (--skip)"
        COUNT_SKIP=$((COUNT_SKIP + 1))
        SKIPPED_TOOLS="$SKIPPED_TOOLS $R_NAME"
        return 0
    fi

    COUNT_PLANNED=$((COUNT_PLANNED + 1))

    if [ "$R_ACTION" = "skip" ]; then
        log "SKIP  $R_NAME ($R_WHY)"
        COUNT_SKIP=$((COUNT_SKIP + 1))
        SKIPPED_TOOLS="$SKIPPED_TOOLS $R_NAME"
        return 0
    fi

    # Idempotency: if the tool's check command is already present, skip.
    if [ "$PT_DRY_RUN" != "1" ] && tool_present "$R_CHECK"; then
        log "SKIP  $R_NAME (already installed)"
        COUNT_SKIP=$((COUNT_SKIP + 1))
        SKIPPED_TOOLS="$SKIPPED_TOOLS $R_NAME"
        return 0
    fi

    log "PLAN  $R_NAME  ->  $R_ACTION ($R_WHY): $R_ARG"

    local ok=0
    if [ "$R_ACTION" = "native" ]; then
        native_install "$R_ARG" || ok=1
    else
        dispatch_fallback "$R_ARG" || ok=1
    fi

    if [ "$ok" -eq 0 ]; then
        COUNT_OK=$((COUNT_OK + 1))
        [ "$PT_DRY_RUN" = "1" ] || log "OK    $R_NAME installed"
    else
        COUNT_FAIL=$((COUNT_FAIL + 1))
        FAILED_TOOLS="$FAILED_TOOLS $R_NAME"
        log "FAIL  $R_NAME (see $LOGFILE)"
    fi
}

# --- Preflight --------------------------------------------------------------
preflight() {
    [ -f "$MANIFEST" ] || die "Manifest not found: $MANIFEST"

    detect_platform || die "No supported package manager found (need apt, dnf, pacman, or brew)."
    log "Detected platform: $(platform_summary)"

    # Root is required for native Linux managers but NOT for Homebrew.
    if [ "$PT_NEEDS_ROOT" -eq 1 ] && [ "$PT_DRY_RUN" != "1" ]; then
        if [ "${EUID:-$(id -u)}" -ne 0 ]; then
            die "$PT_PKG_MGR requires root. Re-run with sudo."
        fi
    fi
    if [ "$PT_PKG_MGR" = "brew" ] && [ "${EUID:-$(id -u)}" -eq 0 ]; then
        die "Homebrew must not be run as root. Re-run as a normal user."
    fi

    mkdir -p "$PT_GIT_DIR"
}

confirm_install() {
    [ "$PT_ASSUME_YES" -eq 1 ] && return 0
    [ "$PT_DRY_RUN" -eq 1 ] && return 0
    printf 'Proceed with installing tools on %s? [y/N]: ' "$PT_PKG_MGR"
    local reply
    read -r reply
    case "$reply" in
        [yY]*) return 0 ;;
        *) log "Installation cancelled by user."; exit 0 ;;
    esac
}

# --- Main -------------------------------------------------------------------
main() {
    DO_LIST=0
    DO_CATEGORIES=0
    parse_args "$@"

    if [ "${DO_LIST:-0}" -eq 1 ]; then
        echo "Tools in manifest ($MANIFEST):"
        for_each_tool list_cb
        exit 0
    fi

    if [ "${DO_CATEGORIES:-0}" -eq 1 ]; then
        print_categories
        exit 0
    fi

    # Sanitize --sample (non-numeric -> 0 = no sampling).
    case "$PT_SAMPLE" in ''|*[!0-9]*) PT_SAMPLE=0 ;; esac

    log "=== pentools_install starting ==="
    preflight
    resolve_selection

    if [ "$PT_SAMPLE" -gt 0 ]; then
        compute_sample_set
        log "Sample mode: first $PT_SAMPLE tool(s) per category"
    fi

    confirm_install

    if [ "$PT_DRY_RUN" -eq 1 ]; then
        log "DRY-RUN mode: no changes will be made."
    else
        log "Refreshing package indexes..."
        refresh_indexes || log "WARN: index refresh failed; continuing"
    fi

    for_each_tool install_cb
    print_summary
    log "=== pentools_install finished ==="
}

main "$@"
